    {
      "parameters": {
        "jsCode": "const msg = $input.first().json;\nconst text = msg.message?.text || '';\nif (text.startsWith('/')) {\n  return [{ json: { skip: true, chatId: msg.message.chat.id.toString(), text } }];\n}\nconst username = msg.message?.from?.username || msg.message?.from?.first_name || 'tester';\nreturn [{\n  json: {\n    skip: false,\n    chatId: msg.message.chat.id.toString(),\n    leadIdentifier: 'tg_' + username.toLowerCase().replace(/[^a-z0-9_]/g, '_'),\n    mensajeActual: text.trim(),\n    canal: 'telegram_test',\n    fuente: 'telegram_test'\n  }\n}];"
      },
