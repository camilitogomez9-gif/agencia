    {
      "parameters": {
        "jsCode": "const normalizado = $('Normalizar Payload').first().json;\nconst airtableRecord = $input.first().json;\n\nconst historialExistente = airtableRecord?.fields?.historial || airtableRecord?.historial || '';\nconst perfilLead = airtableRecord?.fields?.perfil_lead || airtableRecord?.perfil_lead || 'sin_clasificar';\nconst etapaConversion = airtableRecord?.fields?.etapa_conversion || airtableRecord?.etapa_conversion || 'apertura';\nconst recordId = airtableRecord?.id || '';\n\n// Agregar mensaje actual al historial\nconst historialConMensaje = historialExistente\n  ? historialExistente + '\\n[LEAD]: ' + normalizado.mensajeActual\n  : '[LEAD]: ' + normalizado.mensajeActual;\n\nconst historialTruncado = historialConMensaje.length > 3000\n  ? '...(historial truncado)\\n' + historialConMensaje.slice(-3000)\n  : historialConMensaje;\n\nreturn [{\n  json: {\n    ...normalizado,\n    historial: historialTruncado,\n    historialExistente,\n    perfilLead,\n    etapaConversion,\n    recordId\n  }\n}];"
      },
