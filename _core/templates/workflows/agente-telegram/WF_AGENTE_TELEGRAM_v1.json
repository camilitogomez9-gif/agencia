    {
      "parameters": {
        "jsCode": "const parsed = $('Parsear Respuesta').first().json;\nconst lead = $('Preparar Datos del Lead').first().json;\nlet emoji = '🔔', tipo = 'Seguimiento';\nif (parsed.notificarCierre) { emoji = '🎉'; tipo = 'VENTA CERRADA'; }\nelse if (parsed.notificarAgenda) { emoji = '📅'; tipo = 'AGENDA SOLICITADA'; }\nelse if (parsed.notificarDescalificado) { emoji = '❌'; tipo = 'Lead descalificado'; }\nelse if (parsed.notificarFollowup) { emoji = '🔄'; tipo = 'Follow-up pendiente'; }\nconst msg = `${emoji} *${tipo}*\\n\\nLead: \\`${lead.leadIdentifier}\\`\\nCanal: ${lead.canal}\\nPerfil: ${lead.perfilLead}\\nEtapa: ${parsed.nuevaEtapa}\\n\\n_Revisá Airtable para el historial completo._`;\nreturn [{ json: { mensaje: msg } }];"
      },
