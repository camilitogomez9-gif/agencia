        "url": "https://api.notion.com/v1/pages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Notion-Version", "value": "2022-06-28" },
            { "name": "Authorization", "value": "{{NOTION_API_TOKEN}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ parent: { database_id: '2ca27c52c2868015864cecfae6967a5a' }, properties: { Nombre: { title: [{ text: { content: $json.nombre } }] }, Idea: { rich_text: [{ text: { content: $json.idea } }] }, Script: { rich_text: [{ text: { content: $json.script } }] }, Finalizado: { checkbox: false } } }) }}",
        "options": {}
      },
