      "position": [1136, -16]
    },
    {
      "parameters": {
        "jsCode": "const text = $input.item.json.text || '';\n\nconst prompt = `Organizá este mensaje sobre una idea de video para Instagram en el siguiente JSON:\\n\\n- \"nombre\": título corto del video (máximo 8 palabras). Debe describir el tema, no la acción. Nunca empieces con verbos imperativos.\\n- \"idea\": la esencia del video. Eliminá frases de encuadre como \"hacé un reel de\", \"quiero un video sobre\". Arrancá directo con el tema. Mantené el resto lo más literal posible.\\n- \"script\": si el mensaje incluye guión, estructura o puntos, transcribirlo fielmente. Si no, dejarlo como \"\".\\n\\nRespondé ÚNICAMENTE con JSON válido, sin texto extra ni bloques de código.\\n\\nMensaje: ${text}`;\n\nreturn [{ json: { text, prompt } }];"
      },
      "id": "e9e04810-ef83-4f12-88ca-0567d88b0995",
      "name": "Preparar request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1360, -16]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer [GROQ_API_KEY]" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ model: 'llama-3.1-8b-instant', temperature: 0, response_format: { type: 'json_object' }, messages: [{ role: 'user', content: 'Respondé en formato JSON con los campos nombre, idea y script. Mensaje: ' + $json.text }] }) }}",
        "options": {}
      },
      "id": "5bd0acef-b392-44a6-9233-85f9ed7627b5",
      "name": "Parsear idea",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1568, -16]
    },
    {
      "parameters": {
        "jsCode": "const content = $input.item.json.choices[0].message.content;\nconst data = JSON.parse(content);\n\nconst toStr = v => (Array.isArray(v) ? v.join('\\n') : String(v || ''));\n\nreturn [{\n  json: {\n    nombre: toStr(data.nombre).slice(0, 2000) || 'Sin título',\n    idea:   toStr(data.idea).slice(0, 2000),\n    script: toStr(data.script).slice(0, 2000)\n  }\n}];"
      },
      "id": "1d7e49c6-3229-49ea-9411-4378bffe845c",
      "name": "Preparar Notion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1808, -16]
    },
