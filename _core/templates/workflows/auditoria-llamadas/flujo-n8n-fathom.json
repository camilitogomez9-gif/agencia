{
  "name": "Fathom → Notion + Telegram",
  "nodes": [
    {
      "id": "e4f5a6b7-c8d9-4e0f-a1b2-c3d4e5f6a7b8",
      "name": "Fathom Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 300],
      "webhookId": "c1d2e3f4-a5b6-7890-cdef-123456789abc",
      "parameters": {
        "httpMethod": "POST",
        "path": "fathom",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "f5a6b7c8-d9e0-4f1a-b2c3-d4e5f6a7b8c9",
      "name": "Es Consultoría?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [420, 300],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.meeting_title }}",
              "operation": "contains",
              "value2": "Consultoría"
            }
          ]
        }
      }
    },
    {
      "id": "a6b7c8d9-e0f1-4a2b-c3d4-e5f6a7b8c9d0",
      "name": "Set Extract Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [640, 160],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "externalEmail",
              "value": "={{ ($json.body.calendar_invitees.find(i => i.is_external) || $json.body.calendar_invitees[1] || $json.body.calendar_invitees[0])?.email }}"
            },
            {
              "name": "recordingUrl",
              "value": "={{ $json.body.url }}"
            },
            {
              "name": "transcript",
              "value": "={{ $json.body.transcript }}"
            }
          ]
        },
        "options": {
          "keepOnlySet": true
        }
      }
    },
    {
      "id": "b7c8d9e0-f1a2-4b3c-d4e5-f6a7b8c9d0e1",
      "name": "Groq - Resumen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [860, 160],
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_GROQ_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({\"model\":\"llama-3.3-70b-versatile\",\"messages\":[{\"role\":\"system\",\"content\":\"Sos un asistente que resume llamadas de ventas en español. Resumí solo los temas importantes y contexto de la conversación. No incluyas puntos de acción ni próximos pasos. Máximo 3-4 oraciones.\"},{\"role\":\"user\",\"content\":\"Resumí esta llamada:\\n\\n\"+$('Set Extract Data').item.json.transcript.substring(0,4000)}],\"max_tokens\":300,\"temperature\":0.3}) }}",
        "options": {}
      }
    },
    {
      "id": "c8d9e0f1-a2b3-4c4d-e5f6-a7b8c9d0e1f2",
      "name": "Notion - Buscar Prospecto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1080, 160],
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/databases/17027c52c2868065b151cd7e0eb573cb/query",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_NOTION_TOKEN"
            },
            {
              "name": "Notion-Version",
              "value": "2022-06-28"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({\"filter\":{\"property\":\"Email contacto\",\"email\":{\"equals\":$('Set Extract Data').item.json.externalEmail}},\"page_size\":1}) }}",
        "options": {}
      }
    },
    {
      "id": "d9e0f1a2-b3c4-4d5e-f6a7-b8c9d0e1f2a3",
      "name": "Notion - Actualizar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1300, 160],
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://api.notion.com/v1/pages/' + $json.results[0].id }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_NOTION_TOKEN"
            },
            {
              "name": "Notion-Version",
              "value": "2022-06-28"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({\"properties\":{\"Transcripción llamada\":{\"rich_text\":[{\"type\":\"text\",\"text\":{\"content\":$('Set Extract Data').item.json.transcript.substring(0,1990)}}]},\"Grabación llamada\":{\"url\":$('Set Extract Data').item.json.recordingUrl},\"Resumen \":{\"rich_text\":[{\"type\":\"text\",\"text\":{\"content\":$('Groq - Resumen').item.json.choices[0].message.content}}]}}}) }}",
        "options": {}
      }
    },
    {
      "id": "e0f1a2b3-c4d5-4e6f-a7b8-c9d0e1f2a3b4",
      "name": "Es Estratégica?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [640, 440],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.meeting_title }}",
              "operation": "contains",
              "value2": "Estratégica"
            }
          ]
        }
      }
    },
    {
      "id": "f1a2b3c4-d5e6-4f7a-b8c9-d0e1f2a3b4c5",
      "name": "Tiene Accionables?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [860, 440],
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ ($json.body.action_items || []).length }}",
              "operation": "largerThan",
              "value2": 0
            }
          ]
        }
      }
    },
    {
      "id": "a2b3c4d5-e6f7-4a8b-c9d0-e1f2a3b4c5d6",
      "name": "Telegram - Accionables",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1080, 400],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot"
        }
      },
      "parameters": {
        "chatId": "-5222520529",
        "text": "={{ '🧠 *Reunión Estratégica: ' + $json.body.meeting_title + '*\\n\\n*Accionables:*\\n' + $json.body.action_items.map(i => '• ' + i.description).join('\\n') }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      }
    }
  ],
  "connections": {
    "Fathom Webhook": {
      "main": [
        [
          { "node": "Es Consultoría?", "type": "main", "index": 0 }
        ]
      ]
    },
    "Es Consultoría?": {
      "main": [
        [
          { "node": "Set Extract Data", "type": "main", "index": 0 }
        ],
        [
          { "node": "Es Estratégica?", "type": "main", "index": 0 }
        ]
      ]
    },
    "Set Extract Data": {
      "main": [
        [
          { "node": "Groq - Resumen", "type": "main", "index": 0 }
        ]
      ]
    },
    "Groq - Resumen": {
      "main": [
        [
          { "node": "Notion - Buscar Prospecto", "type": "main", "index": 0 }
        ]
      ]
    },
    "Notion - Buscar Prospecto": {
      "main": [
        [
          { "node": "Notion - Actualizar", "type": "main", "index": 0 }
        ]
      ]
    },
    "Es Estratégica?": {
      "main": [
        [
          { "node": "Tiene Accionables?", "type": "main", "index": 0 }
        ]
      ]
    },
    "Tiene Accionables?": {
      "main": [
        [
          { "node": "Telegram - Accionables", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
