<script>
  (function(){
    function loadMermaid(){
      var s=document.createElement('script');
      s.src='https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js';
      s.async=true;
      s.onload=initMermaid;
      s.onerror=function(){ console.warn('Mermaid CDN no disponible en este entorno; los diagramas se ver\u00e1n como texto.'); };
      document.body.appendChild(s);
    }
    // Inject AFTER the window load event so a stalled CDN never blocks page readiness.
    if(document.readyState==='complete') setTimeout(loadMermaid,0);
    else window.addEventListener('load', function(){ setTimeout(loadMermaid,0); });
  })();
  function initMermaid(){
  if(window.mermaid){
    mermaid.initialize({
      startOnLoad:false,
      securityLevel:'loose',
      theme:'base',
      themeVariables:{
        fontFamily:"'Geist Sans',-apple-system,sans-serif",
        fontSize:'13px',
        primaryColor:'#241517',
        primaryBorderColor:'#5f4d42',
        primaryTextColor:'#f3ece8',
        secondaryColor:'#2f1c1f',
        tertiaryColor:'#1a0e0f',
        lineColor:'#9c8a80',
        textColor:'#c9bdb8',
        edgeLabelBackground:'#150b0c',
        clusterBkg:'#150b0c',
        clusterBorder:'#5f4d42'
      },
      flowchart:{ curve:'basis', nodeSpacing:34, rankSpacing:44, padding:10, useMaxWidth:false }
    });
    (function(){
      var blocks = Array.prototype.slice.call(document.querySelectorAll('pre.mermaid'));
      var rendered = new WeakSet();
      function render(el){
        if(rendered.has(el)) return; rendered.add(el);
        try{ mermaid.run({nodes:[el]}); }catch(e){ mermaid.init(undefined, el); }
      }
      if('IntersectionObserver' in window){
        var mo = new IntersectionObserver(function(ents){
          ents.forEach(function(en){ if(en.isIntersecting){ render(en.target); mo.unobserve(en.target); } });
        },{rootMargin:'300px 0px'});
        blocks.forEach(function(b){ mo.observe(b); });
      } else { blocks.forEach(render); }
    })();
  }
  }
</script>
<script>
(function(){
  var reduce = window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  var els = document.querySelectorAll('.reveal');
  if(reduce || !('IntersectionObserver' in window)){els.forEach(function(e){e.classList.add('in');});}
  else{
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(en){ if(en.isIntersecting){ en.target.classList.add('in'); io.unobserve(en.target);} });
    },{threshold:0.14, rootMargin:'0px 0px -8% 0px'});
    els.forEach(function(e){io.observe(e);});
  }
  var glow = document.getElementById('glow');
  var zones = [
    {sel:'#mapa', c:'radial-gradient(600px 500px at 20% 20%, rgba(255,107,0,.16), transparent 60%)'},
    {sel:'#procesos', c:'radial-gradient(700px 600px at 75% 40%, rgba(248,113,113,.16), transparent 60%)'},
    {sel:'#quickwins', c:'radial-gradient(700px 600px at 25% 50%, rgba(52,211,153,.15), transparent 60%)'},
    {sel:'#plataforma', c:'radial-gradient(800px 600px at 50% 30%, rgba(255,107,0,.16), transparent 62%)'},
    {sel:'#visitala', c:'radial-gradient(700px 600px at 50% 70%, rgba(255,107,0,.16), transparent 60%)'},
    {sel:'#cierre', c:'radial-gradient(800px 600px at 50% 60%, rgba(255,107,0,.18), transparent 60%)'}
  ];
  if(!reduce){
    var zio = new IntersectionObserver(function(entries){
      entries.forEach(function(en){ if(en.isIntersecting){ var z=zones.find(function(x){return en.target.matches(x.sel);}); if(z) glow.style.background=z.c; } });
    },{threshold:0.4});
    zones.forEach(function(z){var n=document.querySelector(z.sel); if(n) zio.observe(n);});
    glow.style.background = zones[0].c;
  }
})();
</script>
