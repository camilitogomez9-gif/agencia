<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Diagnóstico Operativo SAG · Fase 1 — SAG Logística × la agencia</title>
<style>
:root{
  --bg:#1a0e0f; --bg-2:#150b0c; --surface:#241517; --surface-2:#2f1c1f;
  --border:rgba(255,255,255,.09); --border-strong:rgba(255,255,255,.16);
  --text:#f3ece8; --text-muted:#ab9d99; --text-dim:#7d716e;
  --sag-1:#ff6b00; --sag-2:#ffb347; --la agencia-1:#8943e3; --la agencia-2:#f239ff;
  --amber:#fbbf24; --ok:#34d399; --pending:#fb923c; --blocked:#f87171;
  --font-display:'Geist Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  --font-mono:'Geist Mono',ui-monospace,SFMono-Regular,Menlo,monospace;
}
*,*::before,*::after{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font-display);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden;}
h1,h2,h3,h4{font-weight:600;text-wrap:balance;margin:0;letter-spacing:-.01em;}
p{margin:0;} a{color:inherit;text-decoration:none;}
::selection{background:var(--sag-1);color:#1a0e0f;}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto;}*{animation-duration:.001ms!important;transition-duration:.001ms!important;}.glow{display:none;}}
.glow{position:fixed;inset:0;z-index:0;pointer-events:none;filter:blur(70px);opacity:.5;transition:background 1.2s ease;}
.wrap{max-width:1120px;margin:0 auto;padding:0 28px;position:relative;z-index:1;}
.eyebrow{font-family:var(--font-mono);font-size:12px;letter-spacing:.16em;text-transform:uppercase;display:flex;align-items:center;gap:10px;margin-bottom:20px;}
.eyebrow .dot{width:7px;height:7px;border-radius:50%;background:currentColor;}
.grad-sag{background:linear-gradient(135deg,var(--sag-1),var(--sag-2));-webkit-background-clip:text;background-clip:text;color:transparent;}
.mono{font-family:var(--font-mono);}
/* nav */
nav.topnav{position:sticky;top:0;z-index:50;background:rgba(21,11,12,.82);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--border);}
nav .inner{max-width:1120px;margin:0 auto;padding:0 28px;height:60px;display:flex;align-items:center;justify-content:space-between;gap:20px;}
.brandmark{display:flex;align-items:center;gap:11px;font-weight:600;font-size:15px;}
.brandmark .x{color:var(--text-dim);font-weight:400;}
.brandmark .sag{color:var(--sag-1);} .brandmark .nx{color:var(--la agencia-2);}
.navlinks{display:flex;gap:26px;font-size:13px;color:var(--text-muted);}
.navlinks a{transition:color .15s;} .navlinks a:hover{color:var(--text);}
.nav-cta{font-family:var(--font-mono);font-size:12px;letter-spacing:.04em;padding:8px 15px;border-radius:999px;border:1px solid var(--border-strong);color:var(--text);}
.nav-cta:hover{border-color:var(--sag-1);}
@media (max-width:820px){.navlinks{display:none;}}
/* hero */
.hero{padding:120px 0 90px;min-height:86vh;display:flex;align-items:center;border-bottom:1px solid var(--border);}
.hero-badges{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:30px;}
.badge{font-family:var(--font-mono);font-size:11.5px;letter-spacing:.05em;padding:6px 12px;border-radius:999px;border:1px solid var(--border-strong);color:var(--text-muted);}
.hero h1{font-size:clamp(36px,6vw,66px);line-height:1.03;max-width:15ch;letter-spacing:-.03em;}
.hero .sub{font-size:clamp(17px,2.2vw,21px);color:var(--text-muted);max-width:54ch;margin-top:26px;}
.scrollhint{margin-top:56px;font-family:var(--font-mono);font-size:12px;letter-spacing:.1em;color:var(--text-dim);display:flex;align-items:center;gap:10px;}
.scrollhint .line{width:34px;height:1px;background:var(--text-dim);position:relative;overflow:hidden;}
.scrollhint .line::after{content:"";position:absolute;inset:0;background:var(--sag-1);animation:sweep 2.4s infinite;}
@keyframes sweep{0%{transform:translateX(-100%)}60%,100%{transform:translateX(100%)}}
/* section shell */
.section{padding:70px 0;position:relative;}
.section h2{font-size:clamp(26px,3.6vw,42px);max-width:22ch;}
.lede{font-size:18px;color:var(--text-muted);max-width:60ch;margin-top:16px;}
.reveal{opacity:0;transform:translateY(26px);transition:opacity .7s cubic-bezier(.2,.7,.2,1),transform .7s cubic-bezier(.2,.7,.2,1);}
.reveal.in{opacity:1;transform:none;}

/* ---------- FLOW DIAGRAM (reusable, detailed) ---------- */
.flow{display:flex;flex-wrap:wrap;align-items:stretch;gap:7px;margin-top:22px;}
.fn{flex:0 1 auto;min-width:96px;max-width:168px;background:var(--surface);border:1px solid var(--border);border-radius:11px;padding:10px 12px;display:flex;flex-direction:column;gap:3px;}
.fn .fi{font-size:15px;line-height:1;}
.fn .ft{font-size:12.5px;font-weight:600;line-height:1.18;}
.fn .fs{font-size:10.5px;color:var(--text-muted);line-height:1.32;}
.fn .tool{align-self:flex-start;margin-top:2px;font-family:var(--font-mono);font-size:8.5px;letter-spacing:.04em;padding:1px 6px;border-radius:5px;background:#1d6f42;color:#d9ffe9;}
.fn.bad{border-color:rgba(248,113,113,.42);background:linear-gradient(160deg,rgba(248,113,113,.1),var(--surface) 66%);}
.fn.ok{border-color:rgba(52,211,153,.36);background:linear-gradient(160deg,rgba(52,211,153,.09),var(--surface) 66%);}
.fa{align-self:center;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;color:var(--text-dim);min-width:20px;}
.fa .ah{font-size:15px;line-height:1;}
.fa .al{font-family:var(--font-mono);font-size:8.5px;letter-spacing:.02em;white-space:nowrap;text-align:center;max-width:78px;line-height:1.2;}
.fa.manual{color:var(--blocked);} .fa.manual .ah{opacity:.9;}
.fa.auto{color:var(--ok);}
.flow-note{margin-top:14px;font-size:12.5px;color:var(--text-dim);display:flex;align-items:flex-start;gap:8px;}
.flow-note b{color:var(--blocked);font-weight:600;}

/* ---------- STANDARDIZED KPIs (fixed order + fixed sizes + justification) ---------- */
.kpis{display:grid;grid-template-columns:1fr 1fr;gap:12px;align-content:start;}
.kpi{border-radius:13px;padding:15px 16px;border:1px solid var(--border);}
.kpi.wide{grid-column:1 / -1;}
.kpi .k{font-family:var(--font-mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;margin-bottom:8px;}
.kpi .v{font-size:22px;font-weight:600;line-height:1.14;letter-spacing:-.01em;}
.kpi .v small{font-size:13px;color:var(--text-muted);font-weight:400;letter-spacing:0;}
.kpi .just{font-size:11px;color:var(--text-dim);margin-top:9px;padding-top:8px;border-top:1px solid var(--border);line-height:1.4;}
.pk .kpi{border-color:rgba(248,113,113,.22);background:linear-gradient(160deg,rgba(248,113,113,.06),var(--surface) 74%);}
.pk .kpi .k{color:var(--blocked);}
.wk .kpi{border-color:rgba(52,211,153,.24);background:linear-gradient(160deg,rgba(52,211,153,.07),var(--surface) 74%);}
.wk .kpi .k{color:var(--ok);}

/* ---------- SYSTEM MAP (top, detailed) ---------- */
.sysmap{margin-top:34px;border:1px solid var(--border);border-radius:16px;padding:22px 22px 18px;background:var(--bg-2);}
.smrow{display:flex;flex-wrap:wrap;align-items:stretch;gap:7px;margin-bottom:8px;}
.smrow:last-of-type{margin-bottom:0;}
.smlane{font-family:var(--font-mono);font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--text-dim);align-self:center;min-width:96px;padding-right:6px;}
.smlegend{display:flex;gap:20px;flex-wrap:wrap;margin-top:16px;padding-top:14px;border-top:1px solid var(--border);font-family:var(--font-mono);font-size:10.5px;color:var(--text-dim);letter-spacing:.03em;}
.smlegend span{display:inline-flex;align-items:center;gap:7px;}
.lgm{width:20px;height:0;border-top:2px dashed var(--blocked);}
.lga{width:20px;height:0;border-top:2px solid var(--text-dim);}

/* narrative panels */
.narrative-intro{padding:80px 0 10px;}
.panel{min-height:auto;display:flex;align-items:center;padding:52px 0;}
.panel .grid2{display:grid;grid-template-columns:1.08fr .92fr;gap:44px;align-items:center;width:100%;}
@media (max-width:900px){.panel .grid2{grid-template-columns:1fr;gap:28px;}.kpis{grid-template-columns:1fr 1fr;}}
@media (max-width:520px){.kpis{grid-template-columns:1fr;}}
.pcode{font-family:var(--font-mono);font-size:12px;letter-spacing:.08em;color:var(--text-dim);}
.panel h3{font-size:clamp(23px,3vw,32px);margin-top:8px;line-height:1.12;}
.panel .who{display:inline-flex;align-items:center;gap:7px;margin-top:18px;font-size:12.5px;color:var(--text-muted);font-family:var(--font-mono);border:1px solid var(--border);border-radius:999px;padding:5px 12px;}
.panel .who b{color:var(--text);font-weight:600;}
#procesos .pcode{color:var(--blocked);}
#quickwins .pcode{color:var(--ok);}
.solchip{display:inline-block;font-family:var(--font-mono);font-size:11px;color:var(--ok);border:1px solid rgba(52,211,153,.3);border-radius:6px;padding:2px 8px;margin-bottom:12px;}

/* resumen */
.resumen{border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:96px 0;background:linear-gradient(180deg,rgba(248,113,113,.05),transparent);}
.rstats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--border);border:1px solid var(--border);border-radius:16px;overflow:hidden;margin-top:38px;}
.rstat{background:var(--bg);padding:28px 24px;}
.rstat .v{font-size:clamp(26px,3.4vw,38px);font-weight:600;line-height:1;color:var(--blocked);}
.rstat .k{font-size:13px;color:var(--text-muted);margin-top:12px;line-height:1.45;}
@media (max-width:820px){.rstats{grid-template-columns:1fr 1fr;}}

/* gcard */
.gcard{position:relative;border-radius:18px;padding:1px;background:linear-gradient(135deg,var(--sag-1),var(--sag-2) 45%,var(--la agencia-1));}
.gcard>.inner{background:var(--surface);border-radius:17px;padding:34px 34px;height:100%;}
/* plataforma */
.platform{padding:120px 0;border-top:1px solid var(--border);background:radial-gradient(1200px 500px at 50% -10%,rgba(255,107,0,.14),transparent 60%),radial-gradient(900px 500px at 80% 110%,rgba(137,67,227,.1),transparent 55%);}
.platform h2{font-size:clamp(30px,5vw,56px);max-width:16ch;line-height:1.04;}
.roles{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:44px;}
.role{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:26px 24px;}
.role .rt{font-size:19px;font-weight:600;}
.role .rd{font-size:14px;color:var(--text-muted);margin-top:12px;line-height:1.55;}
.role ul{margin:14px 0 0;padding-left:18px;color:var(--text-muted);font-size:13.5px;line-height:1.7;}
@media (max-width:820px){.roles{grid-template-columns:1fr;}}
.sunk{margin-top:56px;}
/* visitá */
.visita{padding:110px 0;text-align:center;}
.visita h2{font-size:clamp(28px,4vw,46px);max-width:20ch;margin:0 auto;}
.visita .lede{margin:18px auto 0;text-align:center;}
.btn-visita{margin-top:44px;display:inline-flex;align-items:center;gap:11px;font-family:var(--font-mono);font-size:15px;letter-spacing:.02em;padding:16px 30px;border-radius:999px;color:#1a0e0f;font-weight:600;background:linear-gradient(135deg,var(--sag-1),var(--sag-2));transition:transform .18s,box-shadow .18s;box-shadow:0 14px 40px -14px rgba(255,107,0,.6);}
.btn-visita:hover{transform:translateY(-2px);box-shadow:0 20px 50px -14px rgba(255,107,0,.75);}
.btn-visita .arr{transition:transform .18s;}.btn-visita:hover .arr{transform:translateX(4px);}
footer{border-top:1px solid var(--border);padding:44px 0;color:var(--text-dim);font-size:13px;}
footer .inner{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;}
footer .tag{color:var(--la agencia-2);font-weight:500;}
/* ---------- MERMAID diagram containers (estructura real de los flujos mapeados) ---------- */
.mmwrap{margin-top:22px;border:1px solid var(--border);border-radius:16px;padding:20px 16px;background:var(--bg-2);overflow-x:auto;}
.mmwrap.big{padding:26px 20px;}
.mermaid{margin:0;font-family:var(--font-mono);color:var(--text-dim);opacity:0;transition:opacity .4s;}
.mermaid[data-processed="true"]{opacity:1;}
.mermaid svg{max-width:none;height:auto;display:block;margin:0 auto;}
.mmcaption{margin-top:14px;font-size:12.5px;color:var(--text-dim);line-height:1.5;display:flex;gap:8px;align-items:flex-start;}
.mmcaption b{color:var(--text);font-weight:600;}
/* panel con diagrama a lo ancho + KPIs en fila debajo */
.panel.diag{display:block;padding:52px 0;}
.panel.diag .phead{max-width:64ch;}
.panel.diag .mmwrap{max-height:620px;overflow:auto;}
.panel.diag .kpis{grid-template-columns:repeat(3,1fr);margin-top:22px;}
@media (max-width:820px){.panel.diag .kpis{grid-template-columns:1fr 1fr;}}
@media (max-width:520px){.panel.diag .kpis{grid-template-columns:1fr;}}

/* ===== nav: fit more links ===== */
.navlinks{gap:18px;font-size:12.5px;overflow-x:auto;max-width:64vw;scrollbar-width:none;}
.navlinks::-webkit-scrollbar{display:none;}

/* ===== §0 EXEC SUMMARY — numbers as heroes ===== */
.exec{padding:88px 0 40px;border-bottom:1px solid var(--border);}
.lede-lg{font-size:clamp(17px,2.2vw,21px);color:var(--text-muted);max-width:66ch;margin-top:20px;line-height:1.6;}
.lede-lg b{color:var(--text);font-weight:600;}
.peakfig{margin-top:42px;border:1px solid rgba(255,107,0,.3);border-radius:20px;padding:32px 34px;background:linear-gradient(160deg,rgba(255,107,0,.09),var(--surface) 72%);display:flex;align-items:baseline;gap:26px;flex-wrap:wrap;}
.peakfig .big{font-size:clamp(48px,9.5vw,110px);font-weight:600;line-height:.86;letter-spacing:-.03em;}
.peakfig .side{font-size:15.5px;color:var(--text-muted);max-width:38ch;line-height:1.55;}
.peakfig .side b{color:var(--text);font-weight:600;}
.heronums{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:18px;}
.heronum{border:1px solid var(--border);border-radius:16px;padding:24px 22px;background:var(--surface);}
.heronum .hs{font-family:var(--font-mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--text-dim);margin-bottom:12px;}
.heronum .hn{font-size:clamp(26px,3.4vw,38px);font-weight:600;line-height:1;letter-spacing:-.02em;}
.heronum .hl{font-size:12.5px;color:var(--text-muted);margin-top:12px;line-height:1.45;}
@media (max-width:820px){.heronums{grid-template-columns:1fr 1fr;}}
@media (max-width:520px){.heronums{grid-template-columns:1fr;}}
.covered{display:flex;flex-wrap:wrap;gap:10px;margin-top:34px;}
.covered .cchip{font-family:var(--font-mono);font-size:12px;letter-spacing:.02em;color:var(--text-muted);border:1px solid var(--border-strong);border-radius:999px;padding:8px 15px;}
.covered .cchip b{color:var(--text);}

/* ===== §2 PROCESS INDEX TABLES ===== */
.areahead{display:flex;align-items:baseline;gap:12px;margin-top:44px;}
.areahead h3{font-size:20px;}
.areahead .count{font-family:var(--font-mono);font-size:12px;color:var(--text-dim);letter-spacing:.04em;}
.tablewrap{margin-top:16px;border:1px solid var(--border);border-radius:14px;overflow:hidden;}
.tablescroll{overflow-x:auto;}
table.proc{border-collapse:collapse;width:100%;min-width:660px;font-size:13.5px;}
table.proc th,table.proc td{text-align:left;padding:12px 16px;border-bottom:1px solid var(--border);vertical-align:top;}
table.proc thead th{font-family:var(--font-mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--text-dim);background:var(--bg-2);font-weight:400;}
table.proc tbody tr:last-child td{border-bottom:none;}
table.proc td.code{font-family:var(--font-mono);color:var(--sag-2);white-space:nowrap;font-size:12px;}
table.proc td.name{font-weight:600;color:var(--text);}
table.proc td.who{color:var(--text-muted);white-space:nowrap;font-size:12.5px;}
table.proc td.pain{color:var(--text-muted);line-height:1.45;min-width:220px;}

/* ===== §3 CHAINS + BOTTLENECKS ===== */
.chains{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:28px;}
.chain{border:1px solid var(--border);border-radius:14px;padding:18px 20px;background:var(--surface);}
.chain .cn{font-family:var(--font-mono);font-size:11px;color:var(--sag-2);letter-spacing:.05em;text-transform:uppercase;}
.chain .ct{font-weight:600;margin-top:9px;line-height:1.35;font-size:15px;}
.chain .cp{font-family:var(--font-mono);font-size:12px;color:var(--text-dim);margin-top:8px;line-height:1.5;}
.chain.key{grid-column:1 / -1;border-color:rgba(255,107,0,.38);background:linear-gradient(160deg,rgba(255,107,0,.09),var(--surface) 70%);}
@media(max-width:720px){.chains{grid-template-columns:1fr;}.chain.key{grid-column:auto;}}
.bottlenecks{margin-top:26px;display:flex;flex-direction:column;gap:10px;}
.bn{display:grid;grid-template-columns:auto 1fr;gap:18px;align-items:baseline;border:1px solid var(--border);border-radius:12px;padding:15px 20px;background:var(--bg-2);}
.bn .rank{font-family:var(--font-mono);font-size:22px;font-weight:600;color:var(--blocked);line-height:1;}
.bn .bt{font-size:14.5px;color:var(--text-muted);line-height:1.5;}.bn .bt b{color:var(--text);font-weight:600;}
.bn.top{border-color:rgba(248,113,113,.35);background:linear-gradient(160deg,rgba(248,113,113,.06),var(--bg-2) 74%);}

/* ===== §4 UNDOCUMENTED RISK ===== */
.risks{margin-top:26px;display:grid;grid-template-columns:1fr;gap:1px;background:var(--border);border:1px solid var(--border);border-radius:14px;overflow:hidden;}
.risk{display:grid;grid-template-columns:150px 1.25fr 1fr;gap:20px;background:var(--bg);padding:16px 20px;align-items:start;}
.risk .rc{font-family:var(--font-mono);font-size:12.5px;color:var(--pending);line-height:1.4;}
.risk .rc span{display:block;color:var(--text-dim);font-size:11px;margin-top:3px;}
.risk .rm{font-size:13.5px;color:var(--text);line-height:1.5;}
.risk .rr{font-size:13px;color:var(--text-muted);line-height:1.5;}
.risk.h{background:var(--bg-2);}
.risk.h div{font-family:var(--font-mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--text-dim);}
@media(max-width:720px){.risk{grid-template-columns:1fr;gap:5px;}.risk .rc{color:var(--pending);}}

/* ===== §5 PRIORITIZATION MATRIX (quadrant) ===== */
.matrix{margin-top:38px;position:relative;padding-left:38px;padding-bottom:34px;}
.matrix .yaxis{position:absolute;left:0;top:0;bottom:34px;display:flex;align-items:center;}
.matrix .yaxis span{writing-mode:vertical-rl;transform:rotate(180deg);font-family:var(--font-mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--text-dim);}
.matrix .xaxis{position:absolute;left:38px;right:0;bottom:0;display:flex;justify-content:space-between;font-family:var(--font-mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--text-dim);}
.qgrid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.quad{border:1px solid var(--border);border-radius:16px;padding:20px 22px;background:var(--surface);min-height:172px;}
.quad .qh{font-family:var(--font-mono);font-size:11px;letter-spacing:.05em;color:var(--text-dim);text-transform:uppercase;}
.quad .qt{font-weight:600;margin-top:7px;font-size:16.5px;}
.quad .chips{display:flex;flex-wrap:wrap;gap:7px;margin-top:15px;}
.quad .sol{font-family:var(--font-mono);font-size:11px;padding:4px 9px;border-radius:7px;border:1px solid var(--border-strong);color:var(--text-muted);}
.quad.win{border-color:rgba(52,211,153,.42);background:linear-gradient(160deg,rgba(52,211,153,.1),var(--surface) 66%);}
.quad.win .qt{color:var(--ok);}.quad.win .sol{border-color:rgba(52,211,153,.4);color:#bff3da;}
.quad.big{border-color:rgba(137,67,227,.34);}.quad.big .qt{color:#c9a6f5;}
.matrix-notes{margin-top:18px;display:flex;flex-wrap:wrap;gap:14px 26px;font-size:12.5px;color:var(--text-dim);line-height:1.5;}
.matrix-notes b{color:var(--text-muted);font-weight:600;}
@media(max-width:720px){.qgrid{grid-template-columns:1fr;}.matrix{padding-left:0;}.matrix .yaxis{display:none;}.matrix .xaxis{position:static;margin-top:14px;}}

/* ===== §7 ROADMAP TIMELINE ===== */
