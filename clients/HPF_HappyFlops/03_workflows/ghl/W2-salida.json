        }
      },
      "id": "5089254f-c4d9-48b9-8010-d79543a5c499",
      "name": "W0 · enviar",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        420,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "// W0 devuelve sólo su resultado; le re-pegamos la parte para el resumen.\nconst p = $('Preparar op').first().json;\nconst r = $input.first().json || {};\nreturn [{ json: { ...r, seq: p.seq, texto: p.texto, adjuntos: p.adjuntos,\n                  pausa_seg: p.pausa_seg } }];"
      },
      "id": "e5abac3c-ada0-4ca0-8cbc-5f266dfedde3",
      "name": "Arrastrar contexto",
