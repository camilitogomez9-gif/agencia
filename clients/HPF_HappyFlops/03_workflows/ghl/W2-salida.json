      },
      "id": "8f51d88c-e041-4b0a-8614-e86fb93dcf55",
      "name": "Pausa entre burbujas",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        860,
        220
      ],
      "webhookId": "9a387aa6-e0e0-41f0-9225-c1ee1367a96a"
    },
    {
      "parameters": {
        "jsCode": "// Junta lo que devolvió cada llamada a W0. Este objeto ES la evidencia del envío:\n// lleva el texto exacto que salió y el id que devolvió GHL, para poder releerlo.\nconst enviados = [];\nfor (const it of $input.all()) {\n  const j = it.json || {};\n  const d = (j.data || {});\n  enviados.push({\n    seq: j.seq ?? null,\n    body: j.texto ?? null,\n    attachments: j.adjuntos ?? [],\n    ghl_message_id: d.messageId ?? null,\n    ghl_conversation_id: d.conversationId ?? null,\n    http_status: j.http_status ?? null,\n  });\n}\nenviados.sort((a, b) => (a.seq ?? 0) - (b.seq ?? 0));\nreturn [{ json: {\n  ok: enviados.every(e => e.ghl_message_id),\n  partes_enviadas: enviados.length,\n  enviados,\n} }];"
      },
