    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH base AS (\n  SELECT\n    id,\n    message->>'content' AS content\n  FROM public.n8n_chat_histories\n  WHERE session_id = '{{ $('HappyFlops - Seg. Rebeca').item.json.id }}'\n    AND message->>'type' = 'human'\n    AND message ? 'content'\n    AND (message->>'content') ILIKE 'Mensaje del usuario:%'\n  ORDER BY id DESC\n  LIMIT 7\n),\nnumerados AS (\n  SELECT\n    ROW_NUMBER() OVER (ORDER BY id DESC) AS rn,\n    REGEXP_REPLACE(content, '^\\s*Mensaje del usuario\\s*:\\s*', '') AS body\n  FROM base\n)\nSELECT\n  'Mensaje del usuario ' || rn || ': ' || body AS content\nFROM numerados\nORDER BY rn;  -- queda en orden 1, 2, 3, ... (del más reciente al más viejo)\n",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -576,
        64
      ],
      "id": "6ef574a5-4c13-438e-abac-961893a30bf1",
