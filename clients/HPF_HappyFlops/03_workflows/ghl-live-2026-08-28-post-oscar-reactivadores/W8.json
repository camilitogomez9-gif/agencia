          "cachedResultName": "HPF·GHL · W0 Client"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "op": "get_mensajes",
            "args": "={{ {conversationId: $json.conversationId, limit: 20} }}"
          },
