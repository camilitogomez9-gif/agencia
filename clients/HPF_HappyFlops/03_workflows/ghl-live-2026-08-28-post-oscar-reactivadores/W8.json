      "id": "11e99a4e-6955-453a-9f92-2e2e0765dce5",
      "name": "W0 · mensajes de la conversación",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        384,
        136
      ]
    },
    {
      "parameters": {
        "jsCode": "// De los mensajes de la conversación, los INBOUND posteriores a la marca.\n//\n// `direction` viene 'inbound' | 'outbound'. Se filtra acá y no en la búsqueda porque\n// la API de conversaciones no deja pedir sólo los entrantes.\nconst ctx = $('Elegir conversaciones nuevas').first().json;\nconst marca = Number(ctx._marca || 0);\nconst conv = $('Conversación en curso').first().json;\n\nconst r = ($input.first().json || {}).data || {};\nconst lista = (r.messages && r.messages.messages) || r.messages || [];\n\nconst salida = [];\nfor (const m of Array.isArray(lista) ? lista : []) {\n  if (String(m.direction || '').toLowerCase() !== 'inbound') continue;\n  const ts = Date.parse(m.dateAdded || 0) || 0;\n  if (ts <= marca) continue;\n\n  let adj = m.attachments || [];\n  if (!Array.isArray(adj)) adj = adj ? [adj] : [];\n\n  salida.push({ json: {\n    contactId: m.contactId || conv.contactId,\n    conversationId: conv.conversationId,\n    // id REAL de GHL: idempotencia fuerte, W1 no necesita derivarla\n    messageId: String(m.id),\n    body: String(m.body || ''),\n    attachments: adj,\n    canal: 'WhatsApp',\n    _ts: ts,\n  } });\n}\n// Del más viejo al más nuevo: el orden en que el lead los escribió es el orden en que\n// el agente los tiene que ver.\nsalida.sort((a, b) => a.json._ts - b.json._ts);\nreturn salida;"
      },
      "id": "6711159d-94fa-4829-b71d-7f12a3fe5425",
      "name": "Mensajes entrantes nuevos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        608,
        136
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://[TU-INSTANCIA-N8N]/webhook/hpf-w1-inbound",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({contactId: $json.contactId, conversationId: $json.conversationId, messageId: $json.messageId, body: $json.body, attachments: $json.attachments, canal: $json.canal}) }}",
        "options": {}
      },
      "id": "2ad8be4a-ed94-4df6-8803-2a9eb9a1265b",
      "name": "Entregar a W1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        832,
        208
      ],
      "retryOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "jUb7ZjztncX5ACpc",
          "name": "HPF GHL Webhook Auth"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// La marca nueva es el máximo timestamp visto en esta corrida. Se toma de las\n// conversaciones y NO de los mensajes entregados: si una conversación traía sólo\n// outbound, igual hay que avanzar o se relee para siempre.\nconst el = $('Elegir conversaciones nuevas');\nconst items = el.isExecuted ? el.all().map(i => i.json) : [];\n\nif (items.length && items[0]._arranque) {\n  return [{ json: { tope: Number(items[0].tope || 0), arranque: true, entregados: 0 } }];\n}\n\nlet tope = 0;\nfor (const it of items) tope = Math.max(tope, Number(it.lastMessageDate || 0));\n\nconst ent = $('Mensajes entrantes nuevos');\nconst entregados = ent.isExecuted ? ent.all().length : 0;\nreturn [{ json: { tope, arranque: false, entregados,\n                  conversaciones: items.length } }];"
      },
      "id": "60de5467-c4c5-4ba2-a52b-63f6e1eb9aba",
      "name": "Avanzar marca",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        -56
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE hpf_relay_estado\nSET ultimo_ms = GREATEST(ultimo_ms, $1::bigint), corrido_at = now()\nWHERE id = 1\nRETURNING ultimo_ms;",
        "options": {
          "queryReplacement": "={{ [ $json.tope ] }}"
        }
      },
