      {
        "parameters": {
          "jsCode": "// La marca nueva es el máximo timestamp visto en esta corrida. Se toma de las\n// conversaciones y NO de los mensajes entregados: si una conversación traía sólo\n// outbound, igual hay que avanzar o se relee para siempre.\nconst el = $('Elegir conversaciones nuevas');\nconst items = el.isExecuted ? el.all().map(i => i.json) : [];\n\nif (items.length && items[0]._arranque) {\n  return [{ json: { tope: Number(items[0].tope || 0), arranque: true, entregados: 0 } }];\n}\n\nlet tope = 0;\nfor (const it of items) tope = Math.max(tope, Number(it.lastMessageDate || 0));\n\nconst ent = $('Mensajes entrantes nuevos');\nconst entregados = ent.isExecuted ? ent.all().length : 0;\nreturn [{ json: { tope, arranque: false, entregados,\n                  conversaciones: items.length } }];"
        },
