        "id": "11e99a4e-6955-453a-9f92-2e2e0765dce5",
        "name": "W0 · mensajes de la conversación",
        "type": "n8n-nodes-base.executeWorkflow",
        "typeVersion": 1.2,
        "position": [
          384,
          136
        ]
      },
      {
        "parameters": {
          "jsCode": "// De los mensajes de la conversación, los INBOUND posteriores a la marca.\n//\n// `direction` viene 'inbound' | 'outbound'. Se filtra acá y no en la búsqueda porque\n// la API de conversaciones no deja pedir sólo los entrantes.\nconst ctx = $('Elegir conversaciones nuevas').first().json;\nconst marca = Number(ctx._marca || 0);\nconst conv = $('Conversación en curso').first().json;\n\nconst r = ($input.first().json || {}).data || {};\nconst lista = (r.messages && r.messages.messages) || r.messages || [];\n\nconst salida = [];\nfor (const m of Array.isArray(lista) ? lista : []) {\n  if (String(m.direction || '').toLowerCase() !== 'inbound') continue;\n  const ts = Date.parse(m.dateAdded || 0) || 0;\n  if (ts <= marca) continue;\n\n  let adj = m.attachments || [];\n  if (!Array.isArray(adj)) adj = adj ? [adj] : [];\n\n  salida.push({ json: {\n    contactId: m.contactId || conv.contactId,\n    conversationId: conv.conversationId,\n    // id REAL de GHL: idempotencia fuerte, W1 no necesita derivarla\n    messageId: String(m.id),\n    body: String(m.body || ''),\n    attachments: adj,\n    canal: 'WhatsApp',\n    _ts: ts,\n  } });\n}\n// Del más viejo al más nuevo: el orden en que el lead los escribió es el orden en que\n// el agente los tiene que ver.\nsalida.sort((a, b) => a.json._ts - b.json._ts);\nreturn salida;"
        },
