{
  "nodes": [
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.manychat.com/fb/subscriber/findByCustomField",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "field_id",
              "value": "14840611"
            },
            {
              "name": "field_value",
              "value": "={{ $('Split In Batches (1)').item.json.telefono.replace('+', '') }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
