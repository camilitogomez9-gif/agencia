{
  "name": "CLZ | Round-Robin cal.com → Google Calendar",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "clz-calcom",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1200, 400],
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "Webhook cal.com",
      "webhookId": "clz-calcom-rr-v1"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "p01", "name": "triggerEvent",  "value": "={{ $json.body.triggerEvent }}", "type": "string" },
            { "id": "p02", "name": "uid",           "value": "={{ $json.body.payload.uid }}", "type": "string" },
            { "id": "p03", "name": "iCalUID",       "value": "={{ $json.body.payload.iCalUID ?? '' }}", "type": "string" },
            { "id": "p04", "name": "eventTypeSlug", "value": "={{ $json.body.payload.eventType?.slug ?? $json.body.payload.type ?? '' }}", "type": "string" },
            { "id": "p05", "name": "summary",       "value": "={{ $json.body.payload.title ?? 'Visita Collazo' }}", "type": "string" },
            { "id": "p06", "name": "description",   "value": "={{ $json.body.payload.description ?? '' }}", "type": "string" },
            { "id": "p07", "name": "startTime",     "value": "={{ $json.body.payload.startTime }}", "type": "string" },
            { "id": "p08", "name": "endTime",       "value": "={{ $json.body.payload.endTime }}", "type": "string" },
            { "id": "p09", "name": "location",      "value": "={{ $json.body.payload.location ?? '' }}", "type": "string" },
            { "id": "p10", "name": "attendeeEmail", "value": "={{ $json.body.payload.attendees?.[0]?.email ?? '' }}", "type": "string" },
            { "id": "p11", "name": "attendeeName",  "value": "={{ $json.body.payload.attendees?.[0]?.name ?? '' }}", "type": "string" },
            { "id": "p12", "name": "attendeePhone", "value": "={{ $json.body.payload.responses?.phone ?? $json.body.payload.responses?.telefono ?? '' }}", "type": "string" },
            { "id": "p13", "name": "rescheduleUid", "value": "={{ $json.body.payload.rescheduleUid ?? '' }}", "type": "string" },
            { "id": "p14", "name": "rawPayload",    "value": "={{ JSON.stringify($json.body) }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-960, 400],
      "id": "22222222-2222-4222-8222-222222222222",
      "name": "Parse Payload"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
                "conditions": [
                  { "id": "sw-e1", "leftValue": "={{ $json.triggerEvent }}", "rightValue": "BOOKING_CREATED", "operator": { "type": "string", "operation": "equals" } }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "CREATED"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
                "conditions": [
                  { "id": "sw-e2", "leftValue": "={{ $json.triggerEvent }}", "rightValue": "BOOKING_RESCHEDULED", "operator": { "type": "string", "operation": "equals" } }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "RESCHEDULED"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
                "conditions": [
                  { "id": "sw-e3", "leftValue": "={{ $json.triggerEvent }}", "rightValue": "BOOKING_CANCELLED", "operator": { "type": "string", "operation": "equals" } }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "CANCELLED"
            }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [-720, 400],
      "id": "33333333-3333-4333-8333-333333333333",
