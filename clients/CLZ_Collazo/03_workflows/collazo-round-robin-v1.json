    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE clz_round_robin_state\nSET last_assigned = CASE\n      WHEN last_assigned = 'matias' AND fabian_paused = FALSE THEN 'fabian'\n      WHEN last_assigned = 'fabian' AND matias_paused = FALSE THEN 'matias'\n      ELSE last_assigned\n    END,\n    total_count = total_count + 1,\n    updated_at = NOW()\nWHERE id = 1\nRETURNING last_assigned AS assigned_to, total_count;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [0, 200],
