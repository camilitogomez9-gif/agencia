      "parameters": {
        "jsCode": "const item = $input.first().json;\n\n// Procesar fuentes\nconst raw = item['Fuente lead Rollup (from Leads)'] || '';\nconst fuentes = raw.split(';').filter(f => f.trim() !== '');\nconst counts = {};\nfuentes.forEach(f => {\n  const key = f.trim();\n  counts[key] = (counts[key] || 0) + 1;\n});\nconst fuentesFormateadas = Object.entries(counts)\n  .sort((a, b) => b[1] - a[1])\n  .map(([k, v]) => `<strong>${k}</strong>: ${v}`)\n  .join('<br>');\n\n// Pre-calcular porcentajes (enteros, listos para mostrar)\nconst cualificadosPct = Math.round((item['Cualificados (%)'] || 0) * 100);\nconst conversionPct   = Math.round((item['Tasa de conversión a cita'] || 0) * 100);\nconst asistenciaPct   = Math.round((item['Tasa de asistencia a cita'] || 0) * 100);\n\n// Resumen compacto para pasar al LLM\nconst resumenParaLLM = JSON.stringify({\n  leads_total:          item['Cantidad total de leads'],\n  cualificados:         item['Cualificados'],\n  cualificados_pct:     cualificadosPct,\n  citas_agendadas:      item['Citas agendadas'],\n  conversion_pct:       conversionPct,\n  asistieron:           item['Asisten a cita'],\n  asistencia_pct:       asistenciaPct,\n  no_continuadas:       item['Conversaciones no continuadas'],\n  fuentes_raw:          raw\n});\n\nreturn {\n  ...item,\n  fuentesFormateadas,\n  cualificadosPct,\n  conversionPct,\n  asistenciaPct,\n  resumenParaLLM\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
