      "parameters": {
        "jsCode": "// Normalize Payload — versión BACKFILL\n// Mismo shape que v2 + _sheet_id preservado para Sheets Update.\n// Input: filas del sheet ya filtradas a lead_status = CREATED.\n\nconst items = $input.all();\nconst results = [];\n\n// --- Helpers (idénticos a v2) ---\n\nconst stripMetaPrefix = (v) => (v || '').toString().replace(/^[a-z]+:/, '').trim();\n\nconst titleCase = (s) => (s || '')\n  .toString()\n  .toLowerCase()\n  .replace(/(^|\\s|-)\\p{L}/gu, c => c.toUpperCase());\n\nconst splitName = (full) => {\n  const trimmed = (full || '').toString().trim();\n  if (!trimmed) return { nombre: 'Lead', apellido: '' };\n  const parts = trimmed.split(/\\s+/);\n  return {\n    nombre: titleCase(parts[0]),\n    apellido: parts.length > 1 ? titleCase(parts.slice(1).join(' ')) : ''\n  };\n};\n\nconst parsePhone = (raw) => {\n  if (raw === undefined || raw === null || raw === '') return { valid: false };\n  const cleaned = raw.toString().replace(/^p:\\+?/, '').replace(/[^0-9]/g, '');\n  if (cleaned.length < 10 || cleaned.length > 15) return { valid: false };\n  return { valid: true, phoneNoPlus: cleaned, phoneWithPlus: '+' + cleaned };\n};\n\nconst deriveTipo = (adName) => {\n  const upper = (adName || '').toString().toUpperCase();\n  if (upper.includes('PAPAS') || upper.includes('PAPÁS') ||\n      upper.includes('MAMAS') || upper.includes('MAMÁS')) return 'Padre/Madre';\n  return 'No especificado';\n};\n\nconst deriveFuente = (platform) => {\n  const p = (platform || '').toString().toLowerCase();\n  if (p === 'ig' || p === 'instagram') return 'Instagram';\n  if (p === 'fb' || p === 'facebook') return 'Facebook';\n  return 'Facebook - Instagram';\n};\n\nconst pick = (row, ...keys) => {\n  for (const k of keys) {\n    if (row[k] !== undefined && row[k] !== null && row[k] !== '') return row[k];\n  }\n  return '';\n};\n\n// --- Loop principal ---\n\nfor (const item of items) {\n  const row = item.json;\n\n  // Preservar campos necesarios para Sheets Update (match por `id` con prefijo l:)\n  const sheetId = (row.id || '').toString();\n  const rowNumber = row.row_number;\n\n  const gradoEscolar = pick(row, '¿qué_grado_escolar_cursa_actualmente_tu_hijo(a)?', 'grado_escolar');\n  const cuandoIniciar = pick(row, '¿cuándo_te_gustaría_que_iniciara_sus_estudios?', 'cuando_iniciar');\n  const nivelIngles = pick(row, '¿cuál_es_el_nivel_actual_de_inglés_de_tu_hijo(a)?', 'nivel_ingles');\n\n  let phoneResult = parsePhone(row.whatsapp);\n  if (!phoneResult.valid) phoneResult = parsePhone(row.phone_number);\n\n  if (!phoneResult.valid) {\n    results.push({\n      json: {\n        _error: true,\n        _error_reason: 'Phone inválido: whatsapp=\"' + (row.whatsapp || '') +\n                       '\" phone_number=\"' + (row.phone_number || '') + '\"',\n        _meta_lead_id: stripMetaPrefix(row.id),\n        _sheet_id: sheetId,\n        _row_number: rowNumber,\n        _raw_row: row\n      }\n    });\n    continue;\n  }\n\n  const { nombre, apellido } = splitName(row.full_name);\n\n  // Para backfill: Touch 1 programado AHORA (no +1h) porque enviamos en el momento.\n  // El cron de v2 calcula Touch 2 a +24h y Touch 3 a +72h DESDE Touch 1 programado at.\n  const touch1At = new Date().toISOString();\n\n  results.push({\n    json: {\n      _error: false,\n\n      // Identificación\n      meta_lead_id: stripMetaPrefix(row.id),\n      _sheet_id: sheetId,\n      _row_number: rowNumber,\n\n      // Datos del lead\n      telefono: phoneResult.phoneNoPlus,\n      telefono_con_plus: phoneResult.phoneWithPlus,\n      nombre,\n      apellido,\n      email: (row.email || '').toString().trim().toLowerCase(),\n\n      ad_name: (row.ad_name || '').toString(),\n      platform: (row.platform || '').toString().toLowerCase(),\n\n      grado_escolar: gradoEscolar.toString(),\n      inicio_deseado: cuandoIniciar.toString(),\n      nivel_ingles: nivelIngles.toString(),\n\n      tipo: deriveTipo(row.ad_name),\n      fuente_lead: deriveFuente(row.platform),\n\n      touch_1_programado_at: touch1At,\n\n      origen: 'Form Meta',\n      received_at: new Date().toISOString()\n    }\n  });\n}\n\nreturn results;\n"
      },
