  {
   "parameters": {
    "jsCode": "// Guarda forward-only: nunca degradar un lead con cita confirmada.\n// Si el contacto no existe (GET falló), no-op.\nconst items = $input.all();\nif (!items.length) return [];\nconst resp = items[0].json.contact || items[0].json;\nif (!resp || !resp.id) return [];\nconst cfs = resp.customFields || [];\nconst cfv = (id) => { const f = cfs.find(x => x.id === id); return f ? f.value : null; };\nconst truthy = v => v === true || v === 'true' || (Array.isArray(v) && v.includes('true'));\nconst estadoActual = (cfv('Omg1BvHmpXR0MMGsrpFh') || '').toString().trim();\nconst cita = truthy(cfv('LwXu8AxMLhVGCbNmgzm2'));\nconst terminal = cita || estadoActual === 'Cita confirmada';\nconst contactId = $('When Executed by Another Workflow').first().json.contactId;\nreturn [{ json: { contactId, estado: terminal ? (estadoActual || 'Cita confirmada') : 'Contestó', ultima_actividad: new Date().toISOString() } }];"
   },
