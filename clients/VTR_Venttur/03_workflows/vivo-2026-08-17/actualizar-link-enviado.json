    {
      "id": "9c3122ac-7caa-480b-89ac-e6be555802d9",
      "name": "Code in JavaScript",
      "parameters": {
        "jsCode": "const mensajeRaw = $input.first()?.json?.mensaje;\nconst mensaje = (mensajeRaw ?? \"\").toString();\nconst m = mensaje.toLowerCase();\n\n// 1) Mapa: \"substring del link\" -> \"programa\"\nconst LINK_MAP = [\n  { link: \"promo.venttur.com/aafamilia-agendar\", programa: \"AAFamilia\" },\n  { link: \"promo.venttur.com/summercamp-agendar\", programa: \"SummerCamp\" },\n  { link: \"promo.venttur.com/pw_alemania_agendar\", programa: \"PW_Alemania\" },\n  { link: \"promo.venttur.com/estudiarytrabajar_agendar\", programa: \"EstudiaryTrabajar\" },\n  { link: \"promo.venttur.com/estudiar-y-trabajar-en-australia\", programa: \"Australia\" },\n  { link: \"promo.venttur.com/agendar-ema\", programa: \"EMA\" },\n\n  // Opcionales (por si el mensaje contiene estos en vez de links de agenda)\n  { link: \"@venttur_\", programa: \"Instagram\" },\n];\n\n// 2) Detectar link y programa\nlet programaDetectado = null;\nlet linkDetectado = null;\n\nfor (const item of LINK_MAP) {\n  if (m.includes(item.link)) {\n    programaDetectado = item.programa;\n    linkDetectado = item.link; // guardamos el substring que matcheó\n    break;\n  }\n}\n\n// Caso especial: \"venttur.com\" (evitar falso positivo con \"promo.venttur.com\")\nif (!programaDetectado) {\n  const tienePromo = m.includes(\"promo.venttur.com/\");\n  if (!tienePromo && m.includes(\"venttur.com\")) {\n    programaDetectado = \"Web\";\n    linkDetectado = \"venttur.com\";\n  }\n}\n\n// 3) Output variable: \"<programa>_link_enviado\"\nconst tag = programaDetectado ? `${programaDetectado}_link_enviado` : \"link_no_identificado\";\n\nconst output = {\n  programa: programaDetectado,\n  link_detectado: linkDetectado,\n  tag,\n};\n\n// “Outputea una variable” => agregamos una key dinámica con true\nif (programaDetectado) {\n  output[tag] = true;\n}\n\nreturn [{ json: output }];"
      },
      "position": [
        496,
        352
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
