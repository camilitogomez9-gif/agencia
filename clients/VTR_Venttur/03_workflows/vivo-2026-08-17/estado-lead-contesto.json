      "id": "30ac92cd-5af4-48a2-bec6-654357b816a2",
      "name": "Aplicar guarda",
      "parameters": {
        "jsCode": "// Guarda forward-only: nunca degradar un lead con cita confirmada.\n// Si el lead no existe (search sin resultados), no-op: el alta del lead\n// estampa el estado inicial (ver crear-contacto-clientify-airtable, EDIT B).\nconst items = $input.all();\nif (items.length === 0) {\n  return [];\n}\nconst lead = items[0].json;\nconst terminal = lead['Agendan cita'] === true || lead['Estado conversación'] === 'Cita confirmada';\nreturn [{\n  json: {\n    telefono: lead['Telefono'],\n    estado: terminal ? (lead['Estado conversación'] || 'Cita confirmada') : 'Contestó',\n    ultima_actividad: new Date().toISOString()\n  }\n}];"
      },
      "position": [
        448,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
