=  '{{ $('When Executed by Another Workflow').item.json.id_airtable }}'","options":{"fields":["id","id_2","Telefono","Link asesoría enviado","ID Clientify"]}},"type":"n8n-nodes-base.airtable","typeVersion":2.1,"position":[720,352],"id":"20d94037-7445-4d07-ac21-5dc999b4b289","name":"Obtener ID Clientify","credentials":{"airtableTokenApi":{"id":"[N8N_CREDENTIAL_ID]","name":"Venttur Dashboard"}}},{"parameters":{"jsCode":"const mensajeRaw = $input.first()?.json?.mensaje;\nconst mensaje = (mensajeRaw ?? \"\").toString();\nconst m = mensaje.toLowerCase();\n\n// 1) Mapa: \"substring del link\" -> \"programa\"\nconst LINK_MAP = [\n  { link: \"promo.venttur.com/aafamilia-agendar\", programa: \"AAFamilia\" },\n  { link: \"promo.venttur.com/summercamp-agendar\", programa: \"SummerCamp\" },\n  { link: \"promo.venttur.com/pw_alemania_agendar\", programa: \"PW_Alemania\" },\n  { link: \"promo.venttur.com/estudiarytrabajar_agendar\", programa: \"EstudiaryTrabajar\" },\n  { link: \"promo.venttur.com/estudiar-y-trabajar-en-australia\", programa: \"Australia\" },\n  { link: \"promo.venttur.com/agendar-ema\", programa: \"EMA\" },\n\n  // Opcionales (por si el mensaje contiene estos en vez de links de agenda)\n  { link: \"@venttur_\", programa: \"Instagram\" },\n];\n\n// 2) Detectar link y programa\nlet programaDetectado = null;\nlet linkDetectado = null;\n\nfor (const item of LINK_MAP) {\n  if (m.includes(item.link)) {\n    programaDetectado = item.programa;\n    linkDetectado = item.link; // guardamos el substring que matcheó\n    break;\n  }\n}\n\n// Caso especial: \"venttur.com\" (evitar falso positivo con \"promo.venttur.com\")\nif (!programaDetectado) {\n  const tienePromo = m.includes(\"promo.venttur.com/\");\n  if (!tienePromo && m.includes(\"venttur.com\")) {\n    programaDetectado = \"Web\";\n    linkDetectado = \"venttur.com\";\n  }\n}\n\n// 3) Output variable: \"<programa>_link_enviado\"\nconst tag = programaDetectado ? `${programaDetectado}_link_enviado` : \"link_no_identificado\";\n\nconst output = {\n  programa: programaDetectado,\n  link_detectado: linkDetectado,\n  tag,\n};\n\n// “Outputea una variable” => agregamos una key dinámica con true\nif (programaDetectado) {\n  output[tag] = true;\n}\n\nreturn [{ json: output }];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[496,352],"id":"9c3122ac-7caa-480b-89ac-e6be555802d9","name":"Code in JavaScript"},{"parameters":{"workflowId":{"__rl":true,"value":"mkEP1qFN7MVb9qP0","mode":"list","cachedResultUrl":"/workflow/mkEP1qFN7MVb9qP0","cachedResultName":"Rescate Post-Link - Venttur"},"workflowInputs":{"mappingMode":"defineBelow","value":{"telefono":"={{ $('When Executed by Another Workflow').item.json.id_airtable }}"},"matchingColumns":["telefono"],"schema":[{"id":"telefono","displayName":"telefono","required":false,"defaultMatch":false,"display":true,"canBeUsedToMatch":true,"type":"string","removed":false}],"attemptToConvertTypes":false,"convertFieldsToString":true},"options":{"waitForSubWorkflow":false}},"type":"n8n-nodes-base.executeWorkflow","typeVersion":1.3,"position":[1344,432],"id":"92e0edf8-c336-422a-9ca0-ec7bc40dcf97","name":"Call 'Rescate Post-Link - Venttur'"}],"connections":{"When Executed by Another Workflow":{"main":[[{"node":"Code in JavaScript","type":"main","index":0}]]},"Check 'Link enviado'":{"main":[[{"node":"Ejecutar seguimiento agendamiento","type":"main","index":0},{"node":"Call 'Rescate Post-Link - Venttur'","type":"main","index":0}]]},"Etiquetar Contacto":{"main":[[{"node":"Check 'Link enviado'","type":"main","index":0}],[]]},"Obtener ID Clientify":{"main":[[{"node":"Etiquetar Contacto","type":"main","index":0}]]},"Code in JavaScript":{"main":[[{"node":"Obtener ID Clientify","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","callerPolicy":"workflowsFromSameOwner","availableInMCP":false,"errorWorkflow":"OBkUyb8fuo30DzA9"},"staticData":null,"meta":null,"pinData":{"When Executed by Another Workflow":[{"json":{"id_airtable":"59899999999","mens