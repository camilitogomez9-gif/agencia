   "id": "c1a2b3d4-e5f6-7890-c1a2-b3d4e5f60010",
   "name": "¿Folio válido?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    448,
    272
   ]
  },
  {
   "parameters": {
    "jsCode": "const body = $json.body || $json;\nconst headers = $input.item.json.headers || {};\n\n// Extraer fbclid: primero del body, si no de la URL\nlet fbclid = body.fbclid_completo || null;\nif (!fbclid && body.url) {\n  const m = body.url.match(/[?&]fbclid=([^&]+)/);\n  if (m) fbclid = decodeURIComponent(m[1]);\n}\n\n// Construir fbc: primero del body, si no desde fbclid\nconst ts = body.timestamp || Date.now();\nlet fbc = body.fbc || null;\nif (!fbc && fbclid) {\n  fbc = 'fb.1.' + ts + '.' + fbclid;\n}\n\nreturn [{\n  json: {\n    folio:      body.folio,\n    fbclid:     fbclid,\n    fbc:        fbc,\n    fbp:        body.fbp || null,\n    programa:   body.programa,\n    timestamp:  String(ts),\n    url:        body.url || null,\n    user_agent: body.user_agent || null,\n    ip:         (headers['x-forwarded-for'] || '').split(',')[0].trim() || null,\n  }\n}];"
   },
