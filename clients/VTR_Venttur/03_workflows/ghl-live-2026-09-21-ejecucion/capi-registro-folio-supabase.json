    "query": "INSERT INTO capi_folios (folio,fbclid,fbc,fbp,programa,ts,landing_url,user_agent,ip,updated_at) VALUES ($1,$2,$3,$4,$5,$6,$7,$8,$9,now()) ON CONFLICT (folio) DO UPDATE SET fbclid=EXCLUDED.fbclid,fbc=EXCLUDED.fbc,fbp=EXCLUDED.fbp,programa=EXCLUDED.programa,ts=EXCLUDED.ts,landing_url=EXCLUDED.landing_url,user_agent=EXCLUDED.user_agent,ip=EXCLUDED.ip,updated_at=now()",
