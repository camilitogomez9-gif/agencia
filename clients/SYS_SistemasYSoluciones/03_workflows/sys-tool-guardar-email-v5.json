        "subject": "={{ '📨 Nuevo lead dejó datos — ' + ($('Validate Input').first().json.nombre || $('Validate Input').first().json.email) }}",
        "message": "=<!DOCTYPE html><html><body style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; max-width: 640px; margin: 0 auto; padding: 24px; color: #1a1a1a; background-color: #ffffff;\"><div style=\"background: #0d0a1f; color: #ffffff; padding: 20px 24px; border-radius: 8px 8px 0 0;\"><h2 style=\"margin: 0; font-size: 20px; font-weight: 600;\">📨 Nuevo lead dejó datos</h2><p style=\"margin: 4px 0 0 0; font-size: 14px; color: #a78bfa;\">Canal {{ $('Validate Input').first().json.canal }} · Origen {{ $('Validate Input').first().json.origen }}</p></div><div style=\"background: #ffffff; padding: 24px; border: 1px solid #e5e7eb; border-top: none; border-radius: 0 0 8px 8px;\"><p style=\"margin: 0 0 16px 0; font-size: 14px; color: #374151;\">Un contacto dejó sus datos en la planilla de captura. Todavía no completó toda la cualificación — usen estos datos para hacer seguimiento manual si corresponde.</p><table style=\"width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 14px;\"><tr><td style=\"padding: 8px 0; color: #6b7280; width: 150px; border-bottom: 1px solid #f3f4f6;\">Email</td><td style=\"padding: 8px 0; border-bottom: 1px solid #f3f4f6;\"><a href=\"mailto:{{ $('Validate Input').first().json.email }}\" style=\"color: #7c3aed; text-decoration: none;\"><strong>{{ $('Validate Input').first().json.email }}</strong></a></td></tr><tr><td style=\"padding: 8px 0; color: #6b7280; border-bottom: 1px solid #f3f4f6;\">Nombre</td><td style=\"padding: 8px 0; border-bottom: 1px solid #f3f4f6;\">{{ $('Validate Input').first().json.nombre || '<span style=\"color: #9ca3af;\">no provisto</span>' }}</td></tr><tr><td style=\"padding: 8px 0; color: #6b7280; border-bottom: 1px solid #f3f4f6;\">Teléfono</td><td style=\"padding: 8px 0; border-bottom: 1px solid #f3f4f6;\">{{ $('Validate Input').first().json.telefono || '<span style=\"color: #9ca3af;\">no provisto</span>' }}</td></tr><tr><td style=\"padding: 8px 0; color: #6b7