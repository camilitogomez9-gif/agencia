    {
      "parameters": {
        "jsCode": "const args = $input.first().json;\nconst email = String(args.email || '').trim().toLowerCase();\n\n// Validación email\nif (!email) {\n  return [{ json: { status: 'ERROR', _skip: true, message_to_agent: 'Faltó el email. Pedile al cliente que lo escriba.' } }];\n}\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (!emailRegex.test(email)) {\n  return [{ json: { status: 'ERROR', _skip: true, message_to_agent: `El email \"${email}\" no tiene formato válido. Pedile al cliente que lo confirme.` } }];\n}\n\n// Normalizar origen\nconst origenesValidos = ['newsletter', 'derivacion', 'descuento_insumos', 'otro'];\nconst origen = origenesValidos.includes(String(args.origen || '').toLowerCase())\n  ? String(args.origen).toLowerCase()\n  : 'otro';\n\n// Normalizar canal\nconst canal = String(args.canal || '').trim() || 'desconocido';\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    email,\n    nombre: String(args.nombre || '').trim(),\n    telefono: String(args.telefono || '').trim(),\n    canal,\n    subscriber_id: String(args.subscriber_id || '').trim(),\n    aplicacion_interes: String(args.aplicacion_interes || '').trim(),\n    origen,\n    session_id: String(args.session_id || '').trim() || 'unknown'\n  }\n}];"
      },
