      "parameters": {
        "language": "javaScript",
        "jsCode": "const matches = $input.all();\nif (matches.length === 0) {\n  return [{ json: {\n    status: 'RESOLVED',\n    data: { mes: null, lineas_priorizadas: [], notas_para_agente: '' },\n    message_to_agent: 'No hay configuración mensual activa. Procedé sin priorización específica.',\n    trace_id: $execution.id\n  } }];\n}\nconst cfg = matches[0].json;\nreturn [{ json: {\n  status: 'RESOLVED',\n  data: {\n    mes: cfg.Mes || '',\n    lineas_priorizadas: cfg['Líneas priorizadas'] || [],\n    notas_para_agente: cfg['Notas para agente'] || ''\n  },\n  message_to_agent: cfg['Notas para agente'] ? `Líneas priorizadas este mes: ${(cfg['Líneas priorizadas'] || []).join(', ')}. Nota: ${cfg['Notas para agente']}` : 'Sin priorización particular este mes.',\n  trace_id: $execution.id\n} }];"
      }
    },
