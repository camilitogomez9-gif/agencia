          "value": "tblG5U2rEtu9G8lPH"
        },
        "filterByFormula": "={{ $json.producto ? `OR(FIND(LOWER(\"${String($json.producto).toLowerCase()}\"), LOWER({Insumo}))>0, FIND(LOWER(\"${String($json.producto).toLowerCase()}\"), LOWER({Categoría}))>0)` : ($json.categoria ? `{Categoría} = \"${$json.categoria}\"` : 'TRUE()') }}",
        "limit": 5,
        "options": {}
      }
