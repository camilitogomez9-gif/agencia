    {
      "id": "0878d1ec-ef01-579c-8d43-e4878fa19e44",
      "name": "Format Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const matches = $input.all();\nconst args = $('Execute Workflow Trigger').first().json;\nconst URL_TIENDA = \"https://www.sistemasysoluciones.com\";\n\nif (matches.length === 0 || (!args.producto && !args.categoria)) {\n  return [{ json: {\n    status: 'RESOLVED',\n    data: {\n      url_general: URL_TIENDA,\n      url_categoria: null,\n      url_producto_especifico: null,\n      mensaje_sugerido_agente: `Podés ver y comprar insumos online en ${URL_TIENDA}. Si necesitás ayuda para elegir, te paso con el equipo.`\n    },\n    trace_id: $execution.id\n  } }];\n}\n\nconst primer = matches[0].json;\nreturn [{ json: {\n  status: 'RESOLVED',\n  data: {\n    url_general: URL_TIENDA,\n    url_categoria: null,\n    url_producto_especifico: primer['URL tienda'] || null,\n    producto_referencia: primer['Insumo'] || '',\n    mensaje_sugerido_agente: primer['URL tienda']\n      ? `Encontré ${primer['Insumo']}. Link: ${primer['URL tienda']}. También podés ver el catálogo general en ${URL_TIENDA}.`\n      : `Encontré ${primer['Insumo']} en el catálogo. Para verlo: ${URL_TIENDA}. Si querés que alguien te ayude, te paso con el equipo.`\n  },\n  trace_id: $execution.id\n} }];"
      }
    },
    {
      "id": "4b361faf-249a-5ed6-a96b-c78e4856c36a",
      "name": "Log to sys_tool_calls",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        960,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "cQLxF5deDtmo4HTV",
          "name": "Supabase SYS"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO sys_tool_calls (session_id, tool_name, input_payload, output_payload, status, duration_ms)\nVALUES ($1, 'consultar-url-tienda', $2::jsonb, $3::jsonb, $4, $5)",
        "options": {
          "queryReplacement": "={{ [$('Execute Workflow Trigger').first().json.session_id || 'unknown', JSON.stringify($('Execute Workflow Trigger').first().json), JSON.stringify($json), $json.status || 'success', $json.duration_ms || 0] }}"
        },
        "continueOnFail": true
      },
      "continueOnFail": true,
      "notes": "Log a sys_tool_calls. continueOnFail=true para no romper la tool si Postgres falla."
