    {
      "parameters": {
        "jsCode": "// Obtener todos los items de entrada\nconst items = $input.all();\n\n// Si no hay items, devolvemos mensaje vacío\nif (items.length === 0) {\n  return [{ json: { mensaje: \"No hay horarios ocupados.\" } }];\n}\n\n// Formatear cada slot con el formato requerido\nconst formatter = new Intl.DateTimeFormat('es-ES', {\n  hour: '2-digit',\n  minute: '2-digit',\n  hour12: false,\n});\n\nconst lineas = items.map(item => {\n  const start = new Date(item.json.start);\n  const end = new Date(item.json.end);\n  const inicio = formatter.format(start);\n  const fin = formatter.format(end);\n  return `Desde ${inicio} hasta ${fin}`;\n});\n\n// Si no hay líneas (ningún horario ocupado)\nif (lineas.length === 0) {\n  return [{ json: { mensaje: \"No hay horarios ocupados.\" } }];\n}\n\n// Mensaje final solo con las líneas\nconst mensaje = lineas.join('\\n');\n\nreturn [\n  {\n    json: {\n      mensaje,\n      slots: lineas, // opcional\n    },\n  },\n];\n"
      },
