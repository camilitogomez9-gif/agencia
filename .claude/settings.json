{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "git add -A && (git diff --cached --quiet || git commit -m \"auto: $(git diff --cached --name-only | head -5 | tr '\\n' ', ' | sed 's/,$//')\")",
            "timeout": 30,
            "statusMessage": "Committing changes...",
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/generators/estado-cliente.py\" --hook",
            "timeout": 30,
            "statusMessage": "Actualizando tablero de estado del cliente..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/generators/estado-cliente.py\" --all >/dev/null 2>&1 || true",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
